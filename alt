-- ═══ HTTP WRAPPER ═══
local function httpRequest(opts)
    local reqFn
    if syn and syn.request then reqFn = syn.request
    elseif http and http.request then reqFn = http.request
    elseif request then reqFn = request
    elseif fluxus and fluxus.request then reqFn = fluxus.request
    else
        reqFn = function(o)
            local ok, res = pcall(function()
                return HttpService:RequestAsync({
                    Url = o.Url, Method = o.Method,
                    Headers = o.Headers, Body = o.Body,
                })
            end)
            if ok then return {StatusCode = res.StatusCode, Body = res.Body} end
            return {StatusCode = 0, Body = tostring(res)}
        end
    end
    return reqFn(opts)
end

