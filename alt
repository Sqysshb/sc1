-- Yardımcı: Markdown kod bloklarını temizle
local function cleanCode(text)
    text = text:gsub("```lua", ""):gsub("```Lua", ""):gsub("```LUA", "")
    text = text:gsub("```", "")
    text = text:gsub("^%s+", ""):gsub("%s+$", "")
    return text
end

-- ═══ ANA GÖNDERME FONKSİYONU ═══
local isBusy = false

local function sendMessage()
    if isBusy then return end
    local text = inputBox.Text
    if text == "" or text:match("^%s*$") then return end

    isBusy = true
    sendBtn.Text = "..."
    sendBtn.BackgroundColor3 = COLORS.TextDim

    addUserMessage(text)
    inputBox.Text = ""

    local thinkingRow = addThinkingMessage()

    task.spawn(function()
        local body = HttpService:JSONEncode({
            model = CONFIG.Model,
            messages = {
                { role = "system", content = SYSTEM_PROMPT },
                { role = "user",   content = text },
            },
            temperature = CONFIG.Temperature,
            max_tokens  = CONFIG.MaxTokens,
        })

        local ok, res = pcall(httpRequest, {
            Url = CONFIG.Endpoint,
            Method = "POST",
            Headers = {
                ["Content-Type"]  = "application/json",
                ["Authorization"] = "Bearer " .. CONFIG.APIKey,
            },
            Body = body,
        })

        if thinkingRow then thinkingRow:Destroy() end

        if not ok or not res or res.StatusCode ~= 200 then
            local errMsg = "Bağlantı hatası"
            if res and res.Body then
                errMsg = "HTTP " .. tostring(res.StatusCode) .. ": " .. tostring(res.Body):sub(1, 200)
            end
            addErrorMessage(errMsg)
        else
            local ok2, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
            if not ok2 then
                addErrorMessage("JSON parse hatası")
            else
                local content = data.choices
                    and data.choices[1]
                    and data.choices[1].message
                    and data.choices[1].message.content

                if not content then
                    addErrorMessage("Yanıt boş veya beklenmedik formatta")
                else
                    addAICodeMessage(cleanCode(content))
                end
            end
        end

        isBusy = false
        sendBtn.Text = "Gönder"
        sendBtn.BackgroundColor3 = COLORS.Accent
    end)
end

