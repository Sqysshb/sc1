-- Basit metin AI mesajı (temizleme sonrası vb için)
function addAIMessage_text(text)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 0)
    row.BackgroundTransparency = 1
    row.AutomaticSize = Enum.AutomaticSize.Y
    row.LayoutOrder = tick() * 1000
    row.Parent = messagesScroll

    local rowLayout = Instance.new("UIListLayout")
    rowLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    rowLayout.Parent = row

    local bubble = Instance.new("TextLabel")
    bubble.BackgroundColor3 = COLORS.AIBubble
    bubble.BorderSizePixel = 0
    bubble.Text = text
    bubble.TextColor3 = COLORS.Text
    bubble.Font = Enum.Font.Gotham
    bubble.TextSize = 13
    bubble.TextWrapped = true
    bubble.AutomaticSize = Enum.AutomaticSize.XY
    bubble.TextXAlignment = Enum.TextXAlignment.Left
    bubble.Parent = row

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 12)
    c.Parent = bubble

    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, 10)
    p.PaddingBottom = UDim.new(0, 10)
    p.PaddingLeft = UDim.new(0, 14)
    p.PaddingRight = UDim.new(0, 14)
    p.Parent = bubble

    local sc = Instance.new("UISizeConstraint")
    sc.MaxSize = Vector2.new(400, math.huge)
    sc.Parent = bubble

    scrollToBottom()
end

